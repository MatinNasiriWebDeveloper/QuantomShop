"use strict";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[8804],{8804:function(t,e,i){i.d(e,{q:function(){return b}});var l=i(66383),s=i(52322),n=i(2784),a=i(98780),d=i(98723),r=i(72677),y=i(31039),p=i(82793),c=i(24807);function E(t){var e=t.question,i=t.className,l=t.onCallback,n=t.activeId,a=t.setActiveId,d=e||{},y=d.id,p=d.title,E=d.answer;return(0,s.jsx)("div",{className:"p-4 pb-0",children:(0,s.jsx)(c.U,{className:(0,r.d)(i,"pb-4"),titleClassName:"!p-0",childrenClassName:"!p-0 mt-1",title:(0,s.jsx)("div",{className:"text-subtitle text-icon-high-emphasis",children:p}),id:y,activeId:n,setActiveId:a,onCallback:l,children:(0,s.jsx)("div",{className:"text-body-1 text-icon-neutral-hint",dangerouslySetInnerHTML:{__html:E}})})})}function b(t){var e=t.faqs,i=t.className,c=t.titleClassName,b=t.isShowMore,w=t.hasSubTitle,x=t.onCallback,R=(0,l.Z)((0,n.useState)(""),2),o=R[0],u=R[1],I=null!=e?e:p.T.filter(function(t){return void 0===t.type}).slice(0,5);return(0,s.jsxs)("div",{className:(0,r.d)("flex flex-col",i),children:[(0,s.jsx)("h3",{className:(0,r.d)("text-h2-compact text-icon-high-emphasis text-center mb-8",c),children:"سوالات متداول"}),void 0!==w&&w&&(0,s.jsxs)("div",{className:"text-subtitle text-icon-neutral-hint text-center mb-8",children:["در صورت نیاز به پشتیبانی و مشاوره، از",(0,s.jsx)("span",{className:"text-plus-500",children:"۸ صبح تا ۱۲ شب"})," با شماره",(0,s.jsx)("span",{className:"text-plus-500",children:"۲۱۰۰۹۱۳۳ - ۰۲۱"})," با ما تماس بگیرید."]}),(0,s.jsxs)("div",{className:"bg-white rounded border-complete-200",children:[null==I?void 0:I.map(function(t,e){return(0,s.jsx)(E,{question:t,className:e+1!==I.length?"border-complete-b-200":"",activeId:o,setActiveId:u,onCallback:x},t.title)}),(void 0===b||b)&&(0,s.jsxs)(d.r,{to:"/plus/landing/faqs",className:"flex text-body-1 justify-center items-center text-plus-500 border-complete-t-200 py-3",children:["مشاهده همه",(0,s.jsx)(a.J,{icon:"chevronLeft",size:20,color:(0,y.$)("color-plus-500")})]})]})]})}},82793:function(t,e,i){i.d(e,{T:function(){return d}});var l=i(64665),s=i(42306),n=i(4528),a=i(85931),d=[{id:1,title:"پلاس چیست؟",answer:"پلاس یک سرویس ویژه اشتراک ماهیانه است که شما با پرداخت حق عضویت آن، به مجموعه‌ای از خدمات ویژه دسترسی پیدا می‌کنید که خریدی سریعتر، راحت‌تر و ارزان تر از معمول دیجی‌کالا تجربه کنید."},{id:2,title:"چطور می‌توانم در پلاس عضو شوم؟",answer:"شما می‌توانید وارد حساب کاربری قسمت پلاس شده و روی گزینه \xabخرید اشتراک\xbb کلیک کنید بعد از مراحل ثبت‌نام و پرداخت موفق، شما عضو پلاس شده‌اید. همچنین شما می‌توانید از صفحه اصلی دیجی‌کالا، وارد صفحه پلاس شوید. با کلیک روی \xabخرید اشتراک پلاس\xbb، به قسمت برنامه‌های اشتراک پلاس هدایت می‌شوید. پس از بررسی، برنامه مورد نظرتان را انتخاب و روی گزینه \xabخرید\xbb کلیک کنید."},{id:3,title:"پلاس چه خدماتی را به من ارائه می‌کند؟",answer:"<ul style='padding-right: 20px'><li style='list-style-type: disc'>هدیه نقدی بر روی خرید بیش از هزاران کالا با نشان پلاس</li><li style='list-style-type: disc'>۴ ارسال رایگان ماهانه برای مرسوله‌های دیجی‌کالا (ارسال رایگان مرسوله‌های سوپرمارکتی بیشتر از ۱۵۰,۰۰۰ تومان و مرسوله کالاهای سنگین به غیر از باربری)</li><li style='list-style-type: disc'>ضمانت بازگرداندن ۳۰ روزه کالاها</li><li style='list-style-type: disc'>اطلاع از محصولات شگفت‌انگیز و دسترسی خرید به آنها</li><li style='list-style-type: disc'>دسترسی زودتر به تخفیفهای شگفت انگیز دیجی کالا</li><li style='list-style-type: disc'>پشتیبانی ویژه و اختصاصی</li><li style='list-style-type: disc'>بازه زمانی ارسال اختصاصی</li><li style='list-style-type: disc'>ارسال سریع پلاس بر روی کالا‌ها با نشان ارسال سریع پلاس</li><li style='list-style-type: disc'>۲ ارسال رایگان سوپرمارکت در ماه</li>"+"".concat((0,s.d)(l.X.FIDIPLUS)?"<li style='list-style-type: disc'>اشتراک رایگان فیدی‌پلاس</li>":"")+"</ul>"},{id:4,title:"هزینه و تمدید عضویت در پلاس به چه صورت است؟",answer:'هزینه عضویت پلاس را می‌توانید در قسمت "مشاهده اشتراک‌های پلاس"\xa0 مشاهده کنید. برای عضویت در پلاس، برنامه‌های متفاوتی وجود دارد. توجه داشته باشید که هزینه عضویت پلاس قابل استرداد نبوده و امکان انصراف از پلاس (پیش از پایان مدت اشتراک) وجود ندارد.'},{id:5,title:'ارسال "رایگان پلاس" چیست؟',answer:"<div>اعضای پلاس می‌توانند به ازای هر ماه اشتراک، چهار ارسال رایگان بر روی مرسوله‌های عادی و دو ارسال رایگان سوپرمارکت داشته باشند. جزئیات این مزیت را می‌توانید در صفحه ارسال رایگان پلاس مطالعه کنید. در ادامه به صورت کلی به برخی از شرایط استفاده از این مزیت اشاره شده است:<ul style='padding-right: 20px'><li style='list-style-type: disc'>ارسال رایگان برای مرسوله‌های سوپرمارکت (نشان سبز) برای مبالغ بیشتر از ۱۵۰,۰۰۰ تومان و مرسوله‌های بزرگ و سنگین (به جز باربری)، نیز قابل استفاده است.</li><li style='list-style-type: disc'>اگر یک سفارش عادی، به انتخاب شما، دو مرسوله‌ای شود، دو فرصت از چهار فرصت ارسال رایگان ماهیانه‌تان را استفاده خواهید کرد.</li><li style='list-style-type: disc'>توجه کنید که در صورت انتخاب گزینه \xabارسال توسط فروشنده\xbb، کالا دیگر شامل ارسال رایگان نیست و هزینه ارسال برای آن محاسبه می‌شود. برای استفاده از امکان ارسال رایگان، فقط باید گزینه \xabارسال توسط دیجی‌کالا\xbb را انتخاب کنید.</li></ul><div/>"},{id:6,title:"تمدید خودکار چیست؟",answer:"\xabتمدید خودکار\xbb امکان جدید پلاس است که اشتراک شما را هر ماه به صورت خودکار تمدید می‌کند. با تمدید خودکار دیگر نیاز نیست هر ماه برای تمدید اشتراک به پلاس سر بزنید و فرآیند پرداخت را طی کنید. کافی است یک بار این امکان را فعال کنید تا برای ۱۲ ماه آینده، اشتراک شما هر ماه به صورت خودکار تمدید شود. شما با امضای یک قرارداد آنلاین، اجازه برداشت مبلغ اشتراک ماهانه تمدید خودکار را به بانک طرف قراردادتان داده و به این ترتیب در پایان هر ماه، مبلغ اشتراک از حسابتان برداشت و اشتراک شما یک ماه دیگر تمدید می‌شود. همچنین هر وقت که بخواهید می‌توانید این اشتراک را لغو کنید که از ماه بعد تمدید نشود."},{id:7,title:"امکان لغو تمدید خودکار برای من وجود دارد؟",answer:"<div>بله! هر زمان بخواهید می‌توانید از پروفایل پلاس \xabتمدید خودکار\xbb را لغو کنید. در صورت لغو تمدید خودکار پس از اتمام اشتراک جاری شما، اشتراکتان از ماه بعدی به صورت خودکار فعال نمی‌شود و نمی‌توانید از سرویس‌های زیر استفاده کنید:<ul style='padding-right: 20px'><li style='list-style-type: disc'>ارسال رایگان</li><li style='list-style-type: disc'>۳۰ روز فرصت بازگشت کالا</li><li style='list-style-type: disc'>هدیه نقدی</li><li style='list-style-type: disc'>تخفیف‌های ویژه</li></ul>و بسیاری مزایای دیگر ...</div>"},{id:8,title:"کدام بانک‌ها از اشتراک تمدید خودکار پلاس پشتیبانی می‌کنند؟",answer:"<div>در حال حاضر دارندگان کارت‌های بانکی زیر می‌توانند اقدام به تهیه اشتراک با تمدید خودکار کنند. بانک‌های دیگر به زودی اضافه خواهند شد.<ul style='padding-right: 20px'><li style='list-style-type: disc'>ملت</li><li style='list-style-type: disc'>دی</li><li style='list-style-type: disc'>سامان</li><li style='list-style-type: disc'>اقتصاد نوین</li><li style='list-style-type: disc'>سرمایه</li><li style='list-style-type: disc'>سینا</li><li style='list-style-type: disc'>کشاورزی</li><li style='list-style-type: disc'>مهر ایران</li><li style='list-style-type: disc'>ایران زمین</li><li style='list-style-type: disc'>پست بانک ایران</li></ul></div>"},{id:9,title:"پس از ارائه اطلاعات کارت بانکی برای تمدید خودکار، چطور از امنیت اطلاعات و حساب بانکی‌ام مطمئن شوم؟",answer:"شما اطلاعات کارت بانکی خود را در بستر بانک وارد می‌کنید و دیجی‌کالا و دیجی‌پی نه در ابتدا این اطلاعات را دریافت می‌کنند و نه در ادامه به این اطلاعات دسترسی خواهند داشند، چرا که این اطلاعات در اختیار بانک است. اختیار برداشت وجه اشتراک پلاس را نیز شما در قالب یک قرارداد آنلاین به بانک خود داده‌اید و دیجی‌کالا و دیجی‌پی در این فرآیند نقشی ندارند."},{id:10,title:"آیا می‌توانم اشتراکی که با تمدید خودکار خریده‌ام را لغو کنم و هزینه را پس بگیرم؟",answer:"خیر. هزینه اشتراک خریداری‌شده قابل بازگشت نیست اما شما می‌توانید \xabتمدید خودکار\xbb را لغو کنید تا از ماه آینده مبلغی توسط بانک شما برای خرید اشتراک پرداخت نشود."},{id:11,title:"اگر اشتراک با تمدید خودکار را فعال کنم تا چه زمان فعال می‌ماند؟",answer:"در صورت فعال‌سازی، ۱۲ ماه اشتراک فعال خواهید داشت و در هر زمان می‌توانید \xabتمدید خودکار اشتراک\xbb را لغو کنید."},{id:12,title:"در صورت ادغام حساب‌های کاربری، اشتراک پلاس من حذف می‌شود؟",answer:"فقط اشتراک‌های خریداری‌شده، قابل‌ انتقال هستند. اگر اشتراک شما هدیه دیجی‌‌کالاست یا با کد تخفیف ۱۰۰ درصدی تهیه شده، قابل انتقال به حساب جدید نیست و در صورت ادغام حساب‌ها، اشتراک حذف می‌شود."},{id:13,title:"چطور می‌توانم از عضویت در پلاس انصراف بدهم؟",answer:"پلاس یک سرویس مدت‌دار است و امکان انصراف از آن پیش از پایان مدت اشتراک وجود ندارد. پس از تمام شدن مدت‌زمان آن، اشتراک‌تان به طور خودکار لغو می‌شود."},{id:14,title:"اشتراک \xabرزرو پلاس\xbb چه زمانی فعال می‌شود؟",answer:"کاربران پلاس می‌توانند حداکثر یک اشتراک رزرو داشته باشند. بعد از پرداخت مبلغ، اشتراک جدید برای شما رزرو شده و پس از اتمام زمان اشتراک فعلی، اشتراک رزرو فعال می‌شود. بعد از فعال‌سازی، امکان استفاده از مزایای اشتراک رزرو شده وجود خواهد داشت. توجه داشته باشید که امکان استفاده از ارسال‌های رایگان اشتراک رزرو شده تا زمان پایان اشتراک فعلی وجود نخواهد داشت."},{id:15,title:"در صورت اتمام ارسال‌های رایگان و باقی ماندن روزهای اشتراک چه راه‌حلی برای من وجود دارد؟",answer:"در صورتی که ارسال‌های رایگان خود را قبل از پایان انقضای زمانی اشتراک فعلی به پایان رساندید و باز هم به ارسال رایگان نیاز داشتید می‌توانید نسبت به خرید بسته‌های ارسال رایگان اقدام کنید."},{type:n.n.FREE_DELIVERY,id:21,title:"چگونه می‌توانم از ارسال‌های رایگان پلاس استفاده کنم؟",answer:"برای بهره‌مندی از ارسال‌های رایگان مخصوص اعضای پلاس کافی است اشتراک پلاس را خریداری کنید. پس از عضویت، اطلاعات تکمیلی شامل تعداد ارسال باقی‌مانده و مدت زمان باقی‌مانده، از اشتراک فعلی، در پروفایل پلاس شما در دسترستان است. هزینه ارسال در فرآیند خرید به طور خودکار برای کاربران پلاس رایگان خواهد شد."},{type:n.n.FREE_DELIVERY,id:22,title:"آیا ارسال رایگان شامل همه محصولات دیجی‌کالا می‌شود؟",answer:"<div>ارسال رایگان برای اکثر محصولات دیجی‌کالا قابل استفاده است. با این حال ممکن است برخی از محصولات خاص شامل شرایط متفاوتی باشند. در ادامه به این موارد استثنا اشاره خواهد شد:<ul style='padding-right: 20px'><li style='list-style-type: disc'>اگر کالایی به طور مستقیم توسط فروشنده برایتان ارسال می‌شود (ارسال فروشنده) شامل ارسال رایگان نخواهد شد.</li><li style='list-style-type: disc'>اگر ارسال شما از طریق \xabپست فروشنده\xbb به دستتان برسد، شامل ارسال رایگان نخواهد شد.</li><li style='list-style-type: disc'>سفارشات سوپرمارکتی کمتر از ۱۵۰,۰۰۰ تومان شامل ارسال رایگان نخواهد شد.</li></ul></div>"},{type:n.n.FREE_DELIVERY,id:23,title:"آیا محدودیتی در تعداد ارسال‌های رایگان وجود دارد؟",answer:"<div><div>شما پس از عضویت در پلاس از \xab۴ ارسال رایگان عادی\xbb و \xab۲ ارسال رایگان سوپرمارکت\xbb در ماه، برخوردار می‌شوید. ۴ ارسال رایگان عادی را می‌توانید به انتخاب خودتان برای سفارش‌های عادی، سوپرمارکتی و ارسال امروز استفاده کنید. اما ۲ ارسال رایگان سوپرمارکت تنها برای سفارش‌ کالاهای سوپرمارکتی دیجی‌کالا قابل استفاده است.</div><div> <b>توجه داشته باشید:</b> هزینه ارسال سفارش‌هایی با شرایط زیر برای همه کاربران دیجی‌کالا رایگان است و در این شرایط از ظرفیت ارسال‌های رایگان کاربران پلاس نیز کم نمی‌شود. شرایط سفارش‌های با ارسال رایگان دیجی‌کالا:</div><ul style='padding-right: 10px'><li>۱- سفارش‌های دسته‌بندی موبایل و لپتاپ که همیشه شامل هزینه ارسال رایگان است.</li><li>۲- سفارش‌های بیشتر از یک میلیون تومان از سوپرمارکت دیجی‌کالا، که شامل ارسال رایگان است.</li><li>۳- استفاده از کد تخفیف ارسال رایگان.</li><li>۴- بازه‌های تحویل پیشنهادی از دیجی‌کالا که در آن بازه‌ها ارسال شما رایگان می‌شود.</li></ul></div>"},{type:n.n.FREE_DELIVERY,id:24,title:"چگونه می‌توانم وضعیت سفارشی که شامل ارسال رایگان می‌شود را پیگیری کنم؟",answer:"برای پیگیری سفارش خود می‌توانید در سایت یا اپلیکیشن دیجی‌کالا روی گزینه \xabسفارش‌های من\xbb کلیک کرده و جزئیات وضعیت سفارش و نوع ارسال خود را مشاهده کنید."},{type:n.n.FREE_DELIVERY,id:25,title:"آیا ارسال رایگان پلاس به همه نقاط کشور انجام می‌شود؟",answer:"بله. اگر عضو پلاس باشید، ارسال شما به تمامی شهرهای ایران رایگان خواهد بود اما توجه داشته باشید برای استفاده از \xabارسال سریع کالاهای غیر سوپرمارکتی\xbb باید ساکن یکی از شهرهای تهران، کرج، اصفهان، رشت، ساری یا مشهد باشید."},{type:n.n.FREE_DELIVERY,id:26,title:"اگر عضو پلاس باشم آیا می‌توانم بلافاصله از ارسال رایگان استفاده کنم؟",answer:"بله. شما می‌توانید حتی در حین خرید با افزودن اشتراک پلاس به سفارش خود، ارسال همان سفارش را نیز رایگان کنید."},{type:n.n.FREE_DELIVERY,id:27,title:"آیا امکان بازگشت کالا با ارسال رایگان وجود دارد؟",answer:"بله، کاربران پلاس برای برگرداندن کالا هزینه‌ای پرداخت نمی‌کنند."},{type:n.n.FREE_DELIVERY,id:28,title:"اگر در طول اشتراک از ظرفیت‌های ارسال رایگان خود استفاده نکنم آیا می‌توانم آن را به اشتراک بعدی منتقل کنم؟",answer:"خیر. ارسال‌های رایگان استفاده نشده در هر اشتراک، به اشتراک بعدی منتقل نخواهند شد."},{type:n.n.FRESH_FREE_DELIVERY,id:31,title:"چگونه می‌توانم از ارسال رایگان سوپرمارکتی استفاده کنم؟",answer:"برای استفاده از ارسال رایگان، کافی است که در هنگام ثبت سفارش سوپرمارکتی خود، مبلغ سفارش شما حداقل ۱۵۰,۰۰۰ تومان باشد. سپس در مراحل پرداخت، گزینه ارسال رایگان برای شما فعال می‌شود و می‌توانید بدون پرداخت هزینه ارسال، سفارش خود را ثبت کنید."},{type:n.n.FRESH_FREE_DELIVERY,id:32,title:"آیا ارسال رایگان سوپرمارکت شامل تمام محصولات سوپرمارکتی می‌شود؟",answer:"بله، این مزیت شامل تمامی محصولات موجود در دسته‌بندی سوپرمارکت دیجی‌کالا می‌شود. تا زمانی که مبلغ سفارش شما از ۱۵۰,۰۰۰ تومان بیشتر باشد، می‌توانید از ارسال رایگان استفاده کنید."},{type:n.n.FRESH_FREE_DELIVERY,id:33,title:"آیا این مزیت تنها در شهرهای تهران و کرج قابل استفاده است؟",answer:"بله، در حال حاضر ارسال رایگان سوپرمارکت برای اعضای پلاس تنها در شهرهای تهران و کرج ارائه می‌شود. این امکان به زودی برای شهرهای دیگر هم ایجاد می‌شود."},{type:n.n.FRESH_FREE_DELIVERY,id:34,title:"آیا محدودیتی در تعداد استفاده از ارسال رایگان سوپرمارکتی وجود دارد؟",answer:"کاربران پلاس دارای ۲ ظرفیت ارسال رایگان مخصوص خرید سوپرمارکت دیجی‌کالا هستند، که پس از اتمام این دو ظرفیت می‌توانند از ۴ ظرفیت ارسال رایگان عادی خود نیز برای رایگان کردن هزینه ارسال سفارشات سوپرمارکتی استفاده کنند."},{type:n.n.FRESH_FREE_DELIVERY,id:35,title:"اگر حداقل خرید ۱۵۰,۰۰۰ تومان را نداشته باشم، آیا می‌توانم از ارسال رایگان استفاده کنم؟",answer:"خیر، برای بهره‌مندی از ارسال رایگان سوپرمارکت، مبلغ سفارش شما باید حداقل ۱۵۰,۰۰۰ تومان باشد. در غیر این صورت، هزینه ارسال بر اساس شرایط عادی محاسبه خواهد شد."},{type:n.n.FRESH_FREE_DELIVERY,id:36,title:"چگونه می‌توانم متوجه شوم که از ارسال رایگان سوپرمارکت استفاده کرده‌ام؟",answer:"در بخش حساب کاربری خود در پروفایل پلاس، می‌توانید تعداد دفعات استفاده از ارسال رایگان سوپرمارکت را مشاهده کنید. همچنین، در فرآیند پرداخت، اگر شرایط استفاده از ارسال رایگان را داشته باشید، این گزینه به شما نمایش داده می‌شود."},{type:n.n.JET_FREE_DELIVERY,id:111,title:"ارسال رایگان سوپرمارکتی چه شرایطی دارد؟",answer:"شما می‌توانید در هر ماه ۴ سفارش از سوپرمارکت فوری دیجی‌کالا با حداقل مبلغ ۱۵۰,۰۰۰ تومان را بدون هزینه ارسال ثبت کنید. ارسال رایگان به طور خودکار در زمان پرداخت اعمال می‌شود."},{type:n.n.JET_FREE_DELIVERY,id:112,title:"آیا محدودیتی در انتخاب محصولات سوپرمارکتی وجود دارد؟",answer:"خیر، ارسال رایگان برای تمام محصولات سوپرمارکتی موجود در ارسال سوپرمارکتی ۴۵ دقیقه‌ای قابل استفاده است، از مواد غذایی گرفته تا محصولات بهداشتی و مصرفی روزمره."},{type:n.n.JET_FREE_DELIVERY,id:113,title:"آیا این مزیت برای همه اعضای پلاس فعال است؟",answer:"بله، این ویژگی به طور خودکار برای تمام اعضای پلاس فعال است و نیازی به فعال‌سازی ندارد."},{type:n.n.JET_FREE_DELIVERY,id:114,title:"این سرویس در چه شهرهایی فعال می‌باشد؟",answer:"این سرویس در حال حاضر در شهرهای تهران، کرج، اصفهان، شیراز، اهواز و مشهد فعال می‌باشد."},{type:n.n.RETURN,id:41,title:"آیا ضمانت ۳۰ روزه برای همه کالاها اعمال می‌شود؟",answer:"<div>ضمانت ۳۰ روزه بازگشت کالا شامل اکثر محصولات می‌شود، اما ممکن است برخی از کالاها (مانند محصولات بهداشتی، آرایشی، مواد غذایی و...) به دلایل بهداشتی یا قانونی شامل این ضمانت نشوند. به طور خلاصه کالاهایی همچون لباس زیر، محصولات آرایشی، کارت هدیه، محصولات سوپرمارکتی، کتاب و مجلات، گلدان، فرش و کالای دیجیتال با هدف حفظ حقوق مصرف‌کنندگان شامل این مزیت نمی‌شوند. حتما <a style='color:black; font-weight: bold; text-decoration: underline' href='https://www.digikala.com/faq/category/4/' target='_blank'>شرایط و ضوابط بازگشت کالا</a> را برای هر محصول مطالعه کنید.</div>"},{type:n.n.RETURN,id:42,title:"اگر سفارشم با تأخیر به دستم برسد، پلاس چه اقدامی انجام می‌دهد؟",answer:"در صورتی که در طول اشتراک پلاس سفارش شما در روزی غیر از روز تعیین شده در جزئیات سفارش تحویل داده شود، یک ارسال رایگان به صورت خودکار به ارسال‌های رایگان باقی‌مانده شما در حساب کاربری پلاس اضافه خواهد شد."},{type:n.n.RETURN,id:43,title:"آیا پس از بازگشت کالا، مبلغ پرداختی من به‌طور کامل بازگردانده می‌شود؟",answer:"بله، پس از بررسی و تایید وضعیت کالا توسط تیم پشتیبانی، مبلغ پرداختی شما به‌طور کامل به حساب کاربری یا حساب بانکی شما بازگردانده می‌شود. این فرآیند ممکن است چند روز کاری زمان ببرد."},{type:n.n.RETURN,id:44,title:"در صورت استفاده از ضمانت ۳۰ روزه، آیا هزینه بازگرداندن کالا برای من رایگان است؟",answer:"بله، در صورت استفاده از ضمانت ۳۰ روزه بازگشت کالا، هزینه ارسال کالا برای شما رایگان خواهد بود و شما نیازی به پرداخت هزینه اضافی برای بازگرداندن کالا ندارید."},{type:n.n.PRIORITY,id:51,title:"چگونه می‌توانم از بازه اختصاصی ارسال استفاده کنم؟",answer:"در هنگام ثبت سفارش، اگر عضو پلاس باشید، بازه‌های ارسال اختصاصی به شما نمایش داده می‌شود. شما می‌توانید از بین این بازه‌ها، زمان دلخواه خود را انتخاب کنید و مطمئن باشید که سفارش شما در اولین فرصت تحویل خواهد شد."},{type:n.n.PRIORITY,id:52,title:"آیا بازه‌های اختصاصی ارسال شامل تمامی محصولات می‌شود؟",answer:"بازه‌های اختصاصی ارسال برای اکثر محصولات اعمال می‌شود. با این حال ممکن است برخی محصولات خاص،‌کالاهای حجیم و یا سنگین (مانند مبلمان، صندلی، وسایل برقی بزرگ و ...) به دلیل ویژگی‌های خاص ارسال، شامل این مزیت نشوند. جزئیات دقیق در صفحه تسویه حساب و انتخاب بازه ارسال مشخص خواهد شد."},{type:n.n.PRIORITY,id:53,title:"آیا این مزیت شامل هزینه اضافی می‌شود؟",answer:"بازه‌های اختصاصی ارسال به‌عنوان یکی از مزایای عضویت در پلاس ارائه می‌شود و معمولاً شامل هزینه اضافی نیست. اما در موارد خاص ( کالای سنگین یا فوق سنگین یا برای ارسال‌های فوری، ممکن است هزینه کمی اضافه شود که پیش از تایید نهایی سفارش به شما اطلاع داده خواهد شد.)"},{type:n.n.PRIORITY,id:54,title:"اگر در بازه اختصاصی ارسال کالا به دستم نرسد، چه باید بکنم؟",answer:"بازه‌های اختصاصی ارسال یکی از مزیت‌های عضویت در پلاس است و شامل هزینه اضافی نمی‌شود. اما در موارد خاص (کالای سنگین یا فوق سنگین یا برای ارسال‌های فوری) ممکن است هزینه کمی اضافه شود که پیش از تایید نهایی سفارش به شما اطلاع داده خواهد شد."},{type:n.n.PRIORITY,id:55,title:"آیا می‌توانم بازه اختصاصی ارسال را پس از ثبت سفارش تغییر دهم؟",answer:"تغییر بازه اختصاصی ارسال پس از ثبت سفارش ممکن است، اما بستگی به شرایط سفارش و زمان ارسال دارد. برای تغییر بازه ارسال، باید با پشتیبانی تماس بگیرید تا در صورت امکان، زمان تحویل مورد نظر شما تغییر داده شود."},{type:n.n.PRIORITY,id:56,title:"بازه‌های اختصاصی ارسال چگونه انتخاب می‌شوند؟",answer:"بازه‌های اختصاصی ارسال بر اساس حجم سفارشات و منطقه جغرافیایی شما تعیین می‌شوند. دیجی‌کالا تلاش می‌کند بهترین و سریع‌ترین زمان‌های ممکن را برای اعضای پلاس در نظر بگیرد تا تجربه خرید بهتری داشته باشند."},{type:n.n.PRIORITY,id:57,title:"آیا این مزیت در همه شهرها و مناطق قابل استفاده است؟",answer:"بازه‌های اختصاصی ارسال عمدتا در شهرهای بزرگ و مناطقی که خدمات ارسال سریع دیجی‌کالا ارائه می‌شود در دسترس هستند. با این حال، دیجی‌کالا در حال گسترش این خدمات به مناطق بیشتر است تا همه اعضای پلاس بتوانند از آن بهره‌مند شوند."},{type:n.n.AMAZING,id:61,title:"منظور از شگفت‌انگیز پلاس چیست؟",answer:"شگفت‌انگیز پلاس، تخفیف‌ها و پیشنهادات ویژه‌ای هستند که تنها برای اعضای پلاس در نظر گرفته شده‌اند. این تخفیف‌ها شامل محصولاتی می‌شود که به طور روزانه به‌روزرسانی شده و با قیمتی استثنایی با تخفیف‌هایی مخصوص کاربران پلاس ارائه می‌شوند."},{type:n.n.AMAZING,id:62,title:"چگونه می‌توانم به شگفت‌انگیز پلاس دسترسی پیدا کنم؟",answer:"کافی است عضو پلاس شوید. پس از عضویت، در بخش ویژه‌ای از سایت یا اپلیکیشن دیجی‌کالا، به این پیشنهادات دسترسی خواهید داشت."},{type:n.n.AMAZING,id:63,title:"آیا شگفت‌انگیز پلاس شامل همه محصولات دیجی‌کالا می‌شود؟",answer:"خیر، شگفت‌انگیزهای پلاس برای محصولات خاص و منتخب در نظر گرفته شده‌ که به صورت دوره‌ای تغییر می‌کنند. این محصولات شامل دسته‌بندی‌های مختلفی هستند و برای اعضای پلاس با تخفیف‌های ویژه ارائه می‌شوند."},{type:n.n.AMAZING,id:64,title:"آیا امکان استفاده از شگفت‌انگیزهای پلاس همراه با سایر کدهای تخفیف وجود دارد؟",answer:"شگفت‌انگیزهای پلاس قابل استفاده همراه با سایر کدهای تخفیف نیستند. این تخفیف‌ها به طور جداگانه و با قیمت‌های بسیار مناسب ارائه می‌شوند."},{type:n.n.AMAZING,id:65,title:"مدت زمان اعتبار شگفت‌انگیزهای پلاس چقدر است؟",answer:"مدت زمان اعتبار هر پیشنهاد شگفت‌انگیز پلاس متفاوت است و تا زمانی که موجودی آن محصول در انبار باقی بماند، ادامه دارد. بنابراین توصیه می‌کنیم به محض مشاهده یک پیشنهاد شگفت‌انگیز، برای خرید اقدام کنید تا فرصت را از دست ندهید."},{type:n.n.EARLY_ACCESS,id:71,title:"چگونه می‌توانم از دسترسی زودتر به کالاهای \xabشگفت‌انگیزها\xbb استفاده کنم؟",answer:"پس از خرید اشتراک و عضویت در پلاس، شما به طور خودکار یک ساعت زودتر از دیگران به پیشنهادهای شگفت‌انگیز دسترسی خواهید داشت و در اولویت خرید قرار می‌گیرید."},{type:n.n.EARLY_ACCESS,id:72,title:"آیا دسترسی زودتر به تخفیف‌ها برای همه محصولات اعمال می‌شود؟",answer:"خیر، دسترسی زودتر به تخفیف‌ها برای محصولات خاص و منتخب اعمال می‌شود. این محصولات ممکن است شامل پیشنهادهای \xabشگفت‌انگیزها\xbb، تخفیف‌های فصلی و یا فروش‌های ویژه باشند که اعضای پلاس زودتر از دیگران می‌توانند به آن‌ها دسترسی داشته باشند."},{type:n.n.EARLY_ACCESS,id:73,title:"آیا این مزیت فقط برای مدت زمان مشخصی در دسترس است؟",answer:"دسترسی زودتر به کالاهای \xabشگفت‌انگیزها\xbb تا زمانی که شما عضو پلاس باشید، برای شما فعال است."},{type:n.n.EARLY_ACCESS,id:74,title:"آیا می‌توانم پس از دسترسی زودتر، کالاها را در لیست علاقه‌مندی‌ها ذخیره کنم و بعدا خرید کنم؟",answer:"بله، شما می‌توانید کالاهایی را که از طریق دسترسی زودتر مشاهده می‌کنید به لیست علاقه‌مندی‌های خود اضافه کنید. اما باید توجه داشته باشید که موجودی کالاها محدود است و ممکن است تا زمان خرید، موجودی آن‌ها به پایان برسد."},{type:n.n.OFFLINE_SHOP,id:121,title:"چگونه می‌توانم این تخفیف را دریافت کنم؟",answer:"پس از عضویت در پلاس، با مراجعه به فروشگاه حضوری و اعلام شماره حساب کاربری دیجی‌کالای خود می‌توانید از این تخفیف استفاده کنید. میزان تخفیف متناسب با پلن انتخابی شما می‌باشد.<br/>اشتراک ۱ ماهه، ۱۵۰,۰۰۰ تومان<br/>اشتراک ۳ ماهه، ۳۵۰,۰۰۰ تومان<br/>اشتراک ۶ ماهه، ۷۵۰,۰۰۰ تومان<br/>اشتراک ۱۲ ماهه، ۱,۵۰۰,۰۰۰ تومان"},{type:n.n.OFFLINE_SHOP,id:122,title:"آیا استفاده از این خدمات محدودیت زمانی دارد؟",answer:"بله، استفاده از این خدمات تنها تا زمانی ممکن است که اشتراک پلاس شما فعال باشد."},{type:n.n.OFFLINE_SHOP,id:123,title:"آیا نیاز به پرداخت هزینه‌ی اضافی برای استفاده از این خدمات دارم؟",answer:"خیر، استفاده از این تخفیف به عنوان یکی از مزایای عضویت در پلاس به شما ارائه می‌شود و شامل هزینه‌ی اضافی نیست."},{type:n.n.OFFLINE_SHOP,id:124,title:"آیا می‌توانم تخفیف حضوری پلاس را در چند خرید جداگانه استفاده کنم؟",answer:"بله، اعتبار تخفیف شما می‌تواند در چند خرید حضوری مختلف استفاده شود، تا زمانی که مجموع استفاده‌ها به سقف تعیین‌شده برسد."},{type:n.n.CASHBACK,id:81,title:"هدیه نقدی به چه کالاهایی تعلق می‌گیرد؟",answer:"این کالاها با نشان هدیه نقدی در دیجی‌کالا قابل تشخیص هستند. برای دسترسی راحت‌تر به این کالاها، می‌توانید از قسمت فیلترها در لیست محصولات وب‌سایت، بخش خدمات پلاس، گزینه \xabکالاهای داری هدیه نقدی\xbb را انتخاب کنید و فقط کالاهایی که دارای هدیه نقدی هستند مشاهده کنید."},{type:n.n.CASHBACK,id:82,title:"چگونه می‌توانم از هدیه نقدی استفاده کنم؟",answer:"در حساب کاربری پلاس، بخشی با عنوان \xabهدیه نقدی آماده شده\xbb خواهید دید که با انتخاب دکمه‌ \xabدریافت\xbb، وجه مورد نظر به کیف پول شما واریز خواهد شد. پس از واریز هم پیامکی مبنی بر واریز موفقیت‌آمیز \xabهدیه نقدی\xbb دریافت می‌کنید."},{type:n.n.CASHBACK,id:83,title:"آیا می‌توانم هدیه نقدی را به حساب بانکی خود واریز کنم؟",answer:"خیر، هدیه نقدی تنها به عنوان اعتبار برای خریدهای آینده قابل استفاده است و نمی‌توان آن را به‌صورت نقدی برداشت کرد."},{type:n.n.CASHBACK,id:84,title:"اگر خرید خود را لغو کنم، آیا هدیه نقدی نیز لغو می‌شود؟",answer:"بله، اگر خرید خود را لغو یا مرجوع کنید، هدیه نقدی مربوط به آن خرید نیز لغو خواهد شد. مبلغ هدیه نقدی که به حساب شما اضافه شده است، در صورت لغو خرید به‌طور خودکار از حساب شما کسر می‌شود."},{type:n.n.CASHBACK,id:85,title:"چه زمانی می‌توانم هدیه نقدی خود را دریافت کنم؟",answer:"<div>بر اساس دسته‌بندی کالاهایی که خریده‌اید، زمان دریافت \xabهدیه نقدی\xbb متفاوت است:<ul style='padding-right: 20px'><li style='list-style-type: disc'>دسته‌بندی سوپرمارکتی: پس از تحویل کامل سفارش</li><li style='list-style-type: disc'>دسته‌بندی تلفن همراه: ۷ روز پس از تحویل کامل سفارش</li><li style='list-style-type: disc'>سایر دسته‌بندی‌ها: پس از مهلت ۳۰ روزه بازگشت کالا</li></ul></div>"},{type:n.n.SUPPORT,id:91,title:"چگونه می‌توانم از پشتیبانی اختصاصی استفاده کنم؟",answer:"برای استفاده از پشتیبانی اختصاصی پلاس، کافی است با تیم پشتیبانی پلاس ۶۱۹۳۰۰۰۰ - ۰۲۱ تماس بگیرید. اطلاعات شما به عنوان یک عضو ویژه در سیستم ثبت شده است و به همین دلیل درخواست شما به صورت خودکار در اولویت قرار می‌گیرد."},{type:n.n.SUPPORT,id:92,title:"چه نوع درخواست‌ها و مشکلاتی شامل پشتیبانی اختصاصی می‌شوند؟",answer:"پشتیبانی اختصاصی شامل تمامی درخواست‌ها و مشکلات شما می‌شود، از سوالات ساده مربوط به محصولات گرفته تا مشکلات پیچیده در مورد سفارشات و خدمات. هر نوع درخواستی که داشته باشید، تیم پشتیبانی با اولویت بالا به آن رسیدگی خواهد کرد."},{type:n.n.SUPPORT,id:93,title:"آیا پشتیبانی اختصاصی پلاس در تمامی ساعات شبانه‌روز در دسترس است؟",answer:"پشتیبانی اختصاصی پلاس در طول ۲۴ ساعت روز و هر روز هفته در دسترس خواهد بود. با این حال، شما به عنوان عضو پلاس اولویت ویژه‌ای دارید و در اولین فرصت به درخواست شما پاسخ داده می‌شود."},{type:n.n.SUPPORT,id:94,title:"اگر از پشتیبانی اختصاصی راضی نبودم، چگونه می‌توانم شکایت کنم؟",answer:"اگر تجربه شما از پشتیبانی اختصاصی مطلوب نبود، می‌توانید بلافاصله بعد از تماس به کیفیت خدمات امتیاز دهید و ما را در بهبود کیفیت و پاسخگویی همراهی کنید."},{type:n.n.FIDIPLUS,id:101,title:"چگونه می‌توانم از اشتراک فیدی‌پلاس استفاده کنم؟",answer:"پس از عضویت در پلاس، به‌طور خودکار اشتراک فیدی‌پلاس به حساب فیدیبوی شما اضافه می‌شود. شما می‌توانید با ورود به حساب کاربری خود در فیدیبو، از این اشتراک بهره‌مند شده و به محتوای ویژه آن دسترسی پیدا کنید."},{type:n.n.FIDIPLUS,id:102,title:"آیا اشتراک فیدی‌پلاس محدودیت زمانی دارد؟",answer:"تا زمانی که اشتراک پلاس شما فعال است، اشتراک فیدی‌پلاس نیز برای شما فعال خواهد بود. با این حال، در صورت قطع عضویت پلاس، دسترسی به اشتراک فیدی‌پلاس نیز متوقف می‌شود."},{type:n.n.FIDIPLUS,id:103,title:"آیا می‌توانم اشتراک فیدی‌پلاس را به حساب کاربری دیگری منتقل کنم؟",answer:"خیر، اشتراک فیدی‌پلاس به حساب کاربری شما در فیدیبو مرتبط است و نمی‌توان آن را به حساب دیگری منتقل کرد. این اشتراک مخصوص اعضای پلاس است و فقط به همان حسابی که عضویت پلاس را دارد اختصاص می‌یابد."},{type:n.n.FIDIPLUS,id:104,title:"اگر مشکلی در استفاده از اشتراک فیدی‌پلاس داشتم، چه باید بکنم؟",answer:"در صورت بروز هرگونه مشکل در استفاده از اشتراک فیدی‌پلاس، می‌توانید با پشتیبانی فیدیبو تماس بگیرید. تیم پشتیبانی فیدیبو آماده پاسخگویی و حل مشکلات شما خواهد بود."},{type:n.n.FIDIPLUS,id:105,title:"آیا نیاز به پرداخت هزینه اضافی برای اشتراک فیدی‌پلاس دارم؟",answer:"خیر، اشتراک فیدی‌پلاس به‌عنوان یکی از مزایای عضویت در پلاس به شما ارائه می‌شود و شامل هزینه اضافی نیست."},{type:a.r.TABDEAL,id:141,title:"چطور می‌توانم از سرویس تبدیل استفاده کنم؟",answer:'پس از خرید اشتراک پلاس، کافی‌ست با همان شماره ثبت شده در دیجی کالا وارد حساب کاربری خود در صرافی "تبدیل" شوید یا ثبت نام کنید. با ثبت نام کردن و انجام ماموریت های مشخص شده، ارز دیجیتال شیبا دریافت خواهید کرد.'},{type:a.r.TABDEAL,id:142,title:"آیا محدودیت زمانی برای انجام ماموریت‌ها و دریافت شیبا وجود دارد؟",answer:"بله. تا پایان اعتبار اشتراک پلاس فرصت دارید ماموریت‌های خود را انجام دهید. همچنین پس از انجام هر ماموریت، تا ۷ روز فرصت دارید ارز دیجیتال شیبا خود را دریافت کنید."},{type:a.r.TABDEAL,id:143,title:"آیا اطلاعات حساب کاربری من با صرافی تبدیل به اشتراک گذاشته می‌شود؟",answer:"خیر. هیچ‌یک از اطلاعات حساب کاربری شما با صرافی تبدیل به اشتراک گذاشته نمی‌شود."},{type:a.r.TABDEAL,id:144,title:"آیا برای استفاده از سرویس تبدیل باید هزینه جداگانه‌ای پرداخت کنم؟",answer:"خیر. سرویس تبدیل یکی از مزایای اشتراک پلاس است و استفاده از آن شامل هزینه‌ اضافی نمی‌شود."},{type:a.r.TABDEAL,id:145,title:"در صورت تغییر شماره تماس ثبت‌شده در دیجی‌کالا، آیا همچنان می‌توانم از سرویس تبدیل استفاده کنم؟",answer:"بله. تنها کافی‌ست با شماره جدید خود وارد حساب کاربری‌تان در صرافی تبدیل شوید."},{type:a.r.TABDEAL,id:146,title:"در صورت بروز مشکل در استفاده از تبدیل، چه باید کرد؟",answer:"در صورت بروز هرگونه مشکل، می‌توانید از طریق پشتیبانی دیجی‌کالا یا صرافی تبدیل موضوع را پیگیری و راهنمایی‌های لازم را دریافت کنید."},{type:a.r.TAJROBEH,id:131,title:"چگونه می‌توانم از خدمات مشاوره روان‌شناسی بهره‌مند شوم؟",answer:"پس از عضویت در پلاس، کافی‌ست به وب‌سایت tajrobeh.life مراجعه کرده و با شماره موبایل ثبت‌شده در حساب دیجی‌کالای خود ثبت‌نام کنید. پس از ثبت‌نام، بسته سه جلسه‌ای مشاوره با تخفیف ۱۰٪ ویژه اعضای پلاس در دسترس شما خواهد بود."},{type:a.r.TAJROBEH,id:132,title:"آیا استفاده از این خدمات محدودیت زمانی دارد؟",answer:"خیر، بسته سه جلسه‌ای ارائه شده هر زمان که شما بخواهید قابل استفاده است و بعد از اتمام بسته همچنان میتوانید بسته جدیدی را با همین تخفیف دریافت کنید. "},{type:a.r.TAJROBEH,id:133,title:"آیا برای دریافت تخفیف نیاز به وارد کردن کد خاصی است؟",answer:"خیر، تخفیف به‌صورت خودکار و بر اساس تطابق شماره موبایل ثبت‌شده در پلتفرم تجربه با شماره حساب کاربری دیجی‌کالا اعمال می‌شود. نیازی به وارد کردن کد تخفیف نیست."},{type:a.r.TAJROBEH,id:134,title:"آیا می‌توان از این تخفیف برای فرد دیگری استفاده کرد؟",answer:"خیر، این تخفیف صرفا برای دارنده اشتراک فعال پلاس قابل استفاده است و به دیگران قابل انتقال نیست. شماره موبایل ثبت‌نام‌شده ملاک اعتبارسنجی خواهد بود."},{type:a.r.TAJROBEH,id:135,title:"آیا برای استفاده از این خدمات نیاز به پرداخت هزینه اضافی است؟",answer:"خیر، این خدمت با هدف ارتقاء تجربه کاربران پلاس ارائه شده و مشمول هزینه اضافی نمی‌شود. تنها مبلغ جلسه با احتساب تخفیف از سوی مرکز دریافت خواهد شد."}]},4528:function(t,e,i){i.d(e,{n:function(){return l}});var l={FREE_DELIVERY:"free-delivery",FRESH_FREE_DELIVERY:"fresh-free-delivery",JET_FREE_DELIVERY:"jet-free-delivery",RETURN:"return",PRIORITY:"priority",AMAZING:"amazing",EARLY_ACCESS:"early-access",OFFLINE_SHOP:"offline-shop",CASHBACK:"cashback",SUPPORT:"support",FIDIPLUS:"fidiplus"}},85931:function(t,e,i){i.d(e,{r:function(){return l}});var l={TABDEAL:"tabdeal",TAJROBEH:"tajrobeh"}},24807:function(t,e,i){i.d(e,{U:function(){return r}});var l=i(70865),s=i(52322),n=i(29241),a=i(42663);function d(t){var e=t.title,i=t.children,l=t.className,d=t.titleClassName,r=t.childrenClassName,y=t.onCallback,p=t.id,c=t.activeId,E=t.setActiveId,b=p===c,w=(0,a.dh)("text-caption text-neutral-700",r);return(0,s.jsxs)("div",{className:(0,a.dh)("text-body1-strong",l),children:[(0,s.jsx)(n.D,{className:void 0===d?"border-complete-b-200 py-2":d,titleClassName:"cursor-pointer",label:e,leftIcon:b?"chevronUp":"chevronDown",onClick:function(){E(b?-1:p),null==y||y()}}),(0,s.jsx)("div",{className:(0,a.dh)("grid transition-[grid-template-rows] duration-300 ease-out",b?"grid-rows-[1fr]":"grid-rows-[0fr]"),"aria-hidden":!b,children:(0,s.jsx)("div",{className:(0,a.dh)("min-h-0 overflow-hidden",w),children:i})})]})}function r(t){return(0,s.jsx)(d,(0,l.Z)({},t))}}}]);
