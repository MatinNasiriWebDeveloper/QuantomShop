عضو پلاس، هر ماه از دو ارسال رایگان بیشتر برای سفارش‌های سوپرمارکتی خود بهره‌مند شوید! با خرید حداقل ۱۵۰ هزار تومان از دسته‌بندی سوپرمارکتی در شهرهای تهران و کرج، می‌توانید بدون پرداخت هزینه ارسال، سفارش‌های خود را در منزل دریافت کنید. این مزیت ویژه به شما امکان می‌دهد تا به‌صورت اقتصادی و بدون نگرانی از هزینه ارسال، خریدهای روزمره خود را انجام دهید. با پلاس، خریدهای سوپرمارکتی‌تان راحت‌تر و مقرون‌به‌صرفه‌تر از همیشه خواهد بود!"},{type:eC.n.JET_FREE_DELIVERY,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.JET_FREE_DELIVERY,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.JET_FREE_DELIVERY,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.JET_FREE_DELIVERY,"-m.png"),title:"ارسال رایگان ۴۵ دقیقه‌ای",subTitle:"۴ ارسال رایگان در هر ماه برای سفارش‌های سوپرمارکت فوری دیجی‌کالا",description:"به عنوان عضو پلاس، در هر ماه می‌توانید از ۴ ارسال رایگان برای خریدهای سوپرمارکتی خود بهره‌مند شوید. کافیست با خرید حداقل ۱۵۰,۰۰۰ تومان از دسته‌بندی سوپرمارکتی، سفارش‌های خود را بدون پرداخت هزینه ارسال در کمتر از ۴۵ دقیقه‌ای درب منزل دریافت کنید.\nاین مزیت ویژه برای کاربران در شهرهای تحت پوشش ارسال سوپرمارکتی ۴۵ دقیقه‌ای، از جمله تهران و کرج، فراهم شده است."},{type:eC.n.RETURN,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.RETURN,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.RETURN,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.RETURN,"-m.png"),title:"۳۰ روز ضمانت بازگشت کالا",subTitle:"مهلت بیشتر برای بازگشت کالا به صورت کاملا رایگان",description:"به عنوان عضو پلاس، شما از ضمانت ۳۰ روزه بازگشت کالا برخوردار خواهید بود که این مدت در مقایسه با استاندارد ۷ روزه بازگشت کالا در دیجی‌کالا بسیار بیشتر است. این مزیت به شما فرصت کافی را خواهد داد تا کالای خریداری شده را بررسی کرده و در صورت عدم رضایت، آن را بدون هیچ‌گونه نگرانی و به‌صورت رایگان بازگردانید. با پلاس خیالتان از خریدهای آنلاین راحت‌تر از همیشه خواهد بود."},{type:eC.n.PRIORITY,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.PRIORITY,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.PRIORITY,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.PRIORITY,"-m.png"),title:"بازه ارسال اختصاصی",subTitle:"اختصاص نزدیک‌ترین زمان ارسال فقط برای کاربران پلاس",description:"با عضویت در پلاس، کالاهای خود را سریع‌تر از دیگران دریافت خواهید کرد. این مزیت به معنی ارائه ظرفیت ویژه برای اطمینان از ارسال سریع‌تر کالاها در بازه‌های زمانی کوتاه‌تر به کاربران پلاس است."},{type:eC.n.AMAZING,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.AMAZING,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.AMAZING,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.AMAZING,"-m.png"),title:"شگفت‌انگیز پلاس",subTitle:"دسترسی به کالاهای شگفت‌انگیز با تخفیف‌های اختصاصی و بیشتر، ویژه کاربران پلاس",description:"با عضویت در پلاس، به دنیایی از تخفیف‌های اختصاصی و پیشنهادات شگفت‌انگیز پلاس دسترسی پیدا می‌کنید که تنها برای اعضای پلاس در نظر گرفته شده. تخفیف‌های استثنایی روی محصولات محبوب و پرفروش، فرصتی استثنایی برای خرید کالاهای مورد نیازتان با قیمت‌های استثنائی است. با پلاس، هر خرید تبدیل به یک فرصت شگفت‌انگیز خواهد شد!"},{type:eC.n.EARLY_ACCESS,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.EARLY_ACCESS,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.EARLY_ACCESS,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.EARLY_ACCESS,"-m.png"),title:"دسترسی زودتر به \xabشگفت‌انگیزها\xbb",subTitle:"دسترسی به کالاهای \xabشگفت‌انگیزها\xbb در دیجی‌کالا یک ساعت زودتر از بقیه (هر شب ساعت ۲۳)",description:"به عنوان عضو پلاس، شما همیشه یک قدم جلوتر از دیگران خواهید بود! با دسترسی زودتر به کالاهای بخش \xabشگفت‌انگیزها\xbb، هر شب یک ساعت قبل از دیگران (ساعت ۲۳)، بهترین پیشنهادها را مشاهده و خریداری کنید، هیچ تخفیفی را از دست ندهید و همیشه اولین نفری باشید که از تخفیف‌های هیجان‌انگیز بهره‌مند می‌شود. این مزیت به شما کمک می‌کند تا پیش از اتمام موجودی یا افزایش قیمت‌ها، کالای مورد نظر خود را با تخفیف‌های ویژه خریداری کنید."},{type:eC.n.OFFLINE_SHOP,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.OFFLINE_SHOP,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.OFFLINE_SHOP,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.OFFLINE_SHOP,"-m.png"),title:"تخفیف فروشگاه حضوری دیجی‌کالا",subTitle:"تخفیف ویژه کاربران پلاس در خرید خدمات از فروشگاه حضوری دیجی‌کالا، متناسب با مبلغ سبد خرید",description:"با عضویت در پلاس، امکان بهره‌مندی از تخفیف ویژه برای خرید از دسته‌بندی خدمات (انواع نصب نرم‌افزار و ویندوز، انتقال اطلاعات، اپل‌آیدی و..) در خرید از فروشگاه حضوری دیجی‌کالا فراهم می‌شود. میزان تخفیف براساس طرح عضویت شما بین ۱۵۰,۰۰۰ تومان تا ۱,۵۰۰,۰۰۰ تومان متغیر است."},{type:eC.n.CASHBACK,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.CASHBACK,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.CASHBACK,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.CASHBACK,"-m.png"),title:"هدیه نقدی",subTitle:"بازگشت بخشی از مبلغ سفارش به کیف پول شما برای کالاهای دارای نشان هدیه نقدی",description:"در عضویت پلاس، می‌توانید از هدیه نقدی بهره‌مند شوید. با استفاده از این مزیت، با سفارش کالاهایی که دارای نشان هدیه نقدی هستند، بخشی از مبلغ سفارش به کیف پول شما باز می‌گردد. با امکان هدیه نقدی پلاس، می‌توانید علاوه بر تخفیف‌های معمول، سود بیشتری از خریدتان در دیجی کالا داشته باشید. با پلاس خریدهایتان همیشه ارزش بیشتری دارد!"},{type:eC.n.SUPPORT,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.SUPPORT,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.SUPPORT,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.SUPPORT,"-m.png"),title:"پشتیبانی اختصاصی",subTitle:"رسیدگی ویژه و خارج از نوبت به درخواست‌ها و تماس‌های شما",description:"به عنوان عضو پلاس، شما از پشتیبانی اختصاصی و ویژه بهره‌مند خواهید شد. هر زمان که نیاز به کمک داشتید تیم پشتیبانی پلاس، با اولویت و خارج از نوبت به درخواست شما رسیدگی می‌کنند. با این مزیت، خیالتان راحت خواهد بود که مشکلات و سوالات شما در سریع‌ترین زمان ممکن حل می‌شود. با پلاس، پشت خط منتظر نمی‌مانید!"}].concat((0,eE.Z)((0,eT.d)(eI.X.FIDIPLUS)?[{type:eC.n.FIDIPLUS,image:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.FIDIPLUS,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.FIDIPLUS,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eC.n.FIDIPLUS,"-m.png"),title:"اشتراک فیدی‌پلاس",subTitle:"دسترسی به هزاران کتاب صوتی و الکترونیکی در فیدیبو برای شما",description:"با عضویت در پلاس، از اشتراک ویژه فیدی‌پلاس در فیدیبو بهره‌مند می‌شوید! با این اشتراک اختصاصی، به دنیایی از کتاب‌های الکترونیکی و صوتی دسترسی خواهید داشت و می‌توانید از تخفیف‌های ویژه و پیشنهادهای اختصاصی فیدیبو استفاده کنید. پلاس، تجربه‌ای فراتر از خرید آنلاین!"}]:[])),eP=null,eR=null,eD=n(85931),ew=[{type:eD.r.TABDEAL,image:"/statics/img/png/digiplus/landing/perks/".concat(eD.r.TABDEAL,"-bg.png"),icon:"/statics/img/png/digiplus/landing/perks/".concat(eD.r.TABDEAL,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/perks/".concat(eD.r.TABDEAL,"-m.png"),className:"col-start-auto col-end-auto lg:col-start-2 lg:col-end-3",title:"سرویس تبدیل",subTitle:"حساب کاربری مشترک با پلاس و دریافت شیبا و تخفیف کارمزد با انجام ماموریت‌ها",description:"با عضویت در پلاس، امکان استفاده از سرویس \xabتبدیل\xbb به‌عنوان یکی از مزایای اشتراک برای شما فراهم می‌شود. در این سرویس، با انجام ماموریت‌های مشخص‌شده، ارز دیجیتال شیبا دریافت می‌کنید، و از تخفیف کارمزد در هر تراکنش بهره‌مند خواهید شد."},{type:eD.r.TAJROBEH,image:"/statics/img/png/digiplus/landing/services/".concat(eD.r.TAJROBEH,"-bg.png"),icon:"/statics/img/png/digiplus/landing/services/".concat(eD.r.TAJROBEH,"-d.png"),mobileIcon:"/statics/img/png/digiplus/landing/services/".concat(eD.r.TAJROBEH,"-m.png"),className:"col-start-auto col-end-auto lg:col-start-3 lg:col-end-4",title:"تخفیف روان‌درمانی در مرکز تجربه زندگی",subTitle:"٪۱۰ تخفیف برای ۳ جلسه روان‌درمانی در مرکز تجربه زندگی، ویژه کاربران پلاس",description:"با عضویت در پلاس، امکان بهره‌مندی اختصاصی از خدمات روان‌درمانی مرکز تخصصی سلامت روان \xabتجربه زندگی\xbb برای شما فراهم می‌شود. در چارچوب همکاری جدید میان پلاس و مرکز \xabتجربه زندگی\xbb، اعضای پلاس می‌توانند از تخفیف ویژه ۱۰٪ برای بسته‌های سه جلسه‌ای روان‌درمانی استفاده کنند."}],eB=o()(function(){return Promise.resolve().then(n.bind(n,5815)).then(function(e){return e.DigiplusSubscriptionModal})},{loadableGenerated:{webpack:function(){return[5815]}},ssr:!1}),eA=(0,S.D)({component:function(e){var t=e.ssrData,n=e.pending,i=t||{},r=i.digiplusPrimaryButtonText,o=i.digiplusPlans,c=i.digiplusUser,S=i.digiplusSubscription,C=i.digiplusCanBuySubscription,j=(0,s.Z)((0,a.useState)(),2),P=j[0],R=j[1],w=(0,s.Z)((0,a.useState)(!1),2),B=w[0],A=w[1],k=(0,a.useRef)(null),F=(0,x.e)().redirect,L=(0,h.R)({modalId:"plus-subscription-modal",shouldCloseOtherModals:!0}),O=L.isOpen,M=L.onOpen,U=L.onClose,z=(0,b.v)(_.p.isLoggedIn),Z=(0,b.v)(_.p.digiplusData).digiplusIsActivated,V=(0,f.C)().isDesktop,q=(0,u.cC)(g.U.PLUS_THRESHOLD),H=(null==P?void 0:P.planType)===T.Zt.TRIAL,Y=q?(eR||(eR=ej.map(function(e){return e.type===eC.n.FREE_DELIVERY?(0,eN.Z)((0,ey.Z)({},e),{description:"<div>با خرید اشتراک پلاس، از \xab۴ ارسال رایگان عادی\xbb برای همه کالاهای با سایز نرمال دریافت می‌کنید. این ارسال‌های رایگان شامل مرسوله‌هایی با حداقل ارزش ۲۰۰ هزار تومان است. ما در پلاس برای شما امکانات ویژه‌ای فراهم کردیم که تجربه‌ای بهتر، سریع‌تر و به‌صرفه‌تر از سایر کاربران دیجی‌کالا داشته باشید. شما مشتری ویژه دیجی‌کالا هستید و بسته‌بندی مرسولات شما با رنگ بنفش ویژه مشتریان پلاس متمایز شده است.<div style=\"font-size: 14px; font-weight: 600; color:#424242; text-align: center; margin-top: 24px\">شرایط استفاده </div><ul style='padding-right: 20px'><li style='list-style-type: disc'>ارسال رایگان پلاس برای محصولاتی که نوع ارسال آن‌ها \xabارسال فروشنده\xbb است، اعمال نمی‌شود. (این محصولات در انبار دیجی‌کالا موجود نیست و فروشنده آن‌‌ها را از طریق پست ارسال می‌کند.)</li><li style='list-style-type: disc'>ارسال رایگان پلاس برای مرسوله‌هایی با حداقل ارزش ۲۰۰ هزار تومان اعمال می‌شود.</li><li style='list-style-type: disc'>پلاس تضمین می‌کند که سفارش‌های شما به موقع و به صورت رایگان تحویل داده شوند. در طول اشتراک پلاس اگر سفارش شما در روزی غیر از روز تعیین شده در جزئیات سفارش تحویل داده شود، یک ارسال رایگان به اشتراک شما اضافه خواهد شد.</li><li style='list-style-type: disc'>سفارش‌ سوپرمارکت کمتر از ۱۵۰ هزار تومان، شامل ارسال رایگان نخواهد شد.</li><li style='list-style-type: disc'>توجه داشته باشید: هزینه ارسال سفارش‌هایی با شرایط زیر برای همه کاربران دیجی‌کالا رایگان است و در این شرایط از ظرفیت ارسال‌های رایگان کاربران پلاس نیز کم نمی‌شود. شرایط سفارش‌های با ارسال رایگان دیجی‌کالا:<div>۱- سفارش‌های بیشتر از یک میلیون تومان از سوپرمارکت دیجی‌کالا، که شامل ارسال رایگان است.</div><div>۲- استفاده از کد تخفیف ارسال رایگان.</div><div>۳- بازه‌های تحویل پیشنهادی از دیجی‌کالا که در آن بازه‌ها ارسال شما رایگان می‌شود.</div></li></ul></div>"}):e})),eR):(eP||(eP=ej.map(function(e){return e.type===eC.n.FREE_DELIVERY?(0,eN.Z)((0,ey.Z)({},e),{description:"<div>با خرید اشتراک پلاس، از \xab۴ ارسال رایگان عادی\xbb برای همه کالاها و \xab۲ ارسال رایگان سوپرمارکت\xbb مخصوص کالاهای سوپرمارکتی به ازای هر ماه اشتراک برخوردار شوید. ما در پلاس برای شما امکانات ویژه‌ای فراهم کردیم که تجربه‌ای بهتر، سریع‌تر و به‌صرفه‌تر از سایر کاربران دیجی‌کالا داشته باشید. شما مشتری ویژه دیجی‌کالا هستید و بسته‌بندی مرسولات شما با رنگ بنفش ویژه مشتریان پلاس متمایز شده است.<div style=\"font-size: 14px; font-weight: 600; color:#424242; text-align: center; margin-top: 24px\">شرایط استفاده </div><ul style='padding-right: 20px'><li style='list-style-type: disc'>ارسال رایگان پلاس برای محصولاتی که نوع ارسال آن‌ها \xabارسال فروشنده\xbb است، اعمال نمی‌شود. (این محصولات در انبار دیجی‌کالا موجود نیست و فروشنده آن‌‌ها را از طریق پست ارسال می‌کند.)</li><li style='list-style-type: disc'>پلاس تضمین می‌کند که سفارش‌های شما به موقع و به صورت رایگان تحویل داده شوند. در طول اشتراک پلاس اگر سفارش شما در روزی غیر از روز تعیین شده در جزئیات سفارش تحویل داده شود، یک ارسال رایگان به اشتراک شما اضافه خواهد شد.</li><li style='list-style-type: disc'>سفارش‌ سوپرمارکت کمتر از ۱۵۰ هزار تومان، شامل ارسال رایگان نخواهد شد.</li><li style='list-style-type: disc'>توجه داشته باشید: هزینه ارسال سفارش‌هایی با شرایط زیر برای همه کاربران دیجی‌کالا رایگان است و در این شرایط از ظرفیت ارسال‌های رایگان کاربران پلاس نیز کم نمی‌شود. شرایط سفارش‌های با ارسال رایگان دیجی‌کالا:<div>۱- سفارش‌های بیشتر از یک میلیون تومان از سوپرمارکت دیجی‌کالا، که شامل ارسال رایگان است.</div><div>۲- استفاده از کد تخفیف ارسال رایگان.</div><div>۳- بازه‌های تحویل پیشنهادی از دیجی‌کالا که در آن بازه‌ها ارسال شما رایگان می‌شود.</div></li></ul></div>"}):e})),eP),G=function(e){(0,v.d0)({clickedItemName:e,widgetName:p.Jy})},J=function(){F({url:m.iV})},W=function(e){G(e),M()};return(0,a.useEffect)(function(){(0,y.x)(o)||R(null==o?void 0:o.find(function(e){return null==e?void 0:e.planIsSelected}))},[o]),(0,a.useEffect)(function(){"true"===(0,I.p)("open_subscription_modal")&&W("open subscription modal button - query param");var e=new IntersectionObserver(function(e){var t=(0,s.Z)(e,1)[0];A(t.boundingClientRect.top<0&&!t.isIntersecting&&!V)},{root:null,threshold:0});return(null==k?void 0:k.current)&&e.observe(null==k?void 0:k.current),function(){(null==k?void 0:k.current)&&e.unobserve(null==k?void 0:k.current)}},[]),(0,l.jsxs)(l.Fragment,{children:[(0,l.jsx)(d(),{children:(0,l.jsx)("title",{children:(0,N.t)({title:"پلاس",suffix:"خدمات ویژه کاربران دیجی‌کالا"})})}),(0,l.jsxs)("div",{className:"bg-plus-neutral",children:[(0,l.jsx)(Q.h,{}),(0,l.jsx)(ee.V,{}),(0,l.jsx)(eh,{isLoggedIn:!!z}),Z?(0,l.jsx)(e_,{firstName:null==c?void 0:c.userFirstName,subscription:S,isPending:!!n}):(0,l.jsx)(ef,{plans:o,selectedPlan:P,onSelectPlan:function(e){return function(){R(e)}},isPending:!!n,primaryButtonText:r,onOpenSubscriptionModal:W,firstName:null==c?void 0:c.userFirstName,onGoToKYC:function(){G("kyc button"),F({url:m.s8})}}),(0,l.jsx)($,{features:Y,fe